NODE_ENV=production
PORT=5000

# Database
POSTGRES_USER=preppilot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=preppilot_db
DATABASE_URL=postgresql://preppilot:change_me_strong_password@postgres:5432/preppilot_db

# Redis
REDIS_URL=redis://redis:6379

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
AI_INTERVIEW_URL=http://ai-interview:8001
AI_LEARNING_URL=http://ai-learning:8002
AI_RESUME_URL=http://ai-resume:8003
AI_COPILOT_URL=http://ai-copilot:8004

# AI services call Gemini directly (see ai-services/.env.example)

# Frontend URL (for CORS + email links)
FRONTEND_URL=https://yourdomain.com

# File Storage (S3)
S3_BUCKET=preppilot-files
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Email (SMTP) — for password reset emails
# Use SendGrid, AWS SES, Resend, or any SMTP provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com
