# ─────────────────────────────────────────────────────────────
# PrepPilot — root .env.example
#
# Copy to `.env` at the repository root and fill in real values:
#   cp .env.example .env
#
# This file drives `docker compose up` (database credentials and the
# URLs/inline build-time variables shared with the frontend).
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (used by docker-compose.yml) ──────────────────
POSTGRES_USER=preppilot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=preppilot_db

# ── Frontend origin (CORS + password-reset email links) ──────
# Local Docker: http://localhost:3000
# Production:    https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# ── Frontend build-time variables (inlined into the client) ──
# These must be FULL URLs (including /api) and are baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=http://localhost:5000